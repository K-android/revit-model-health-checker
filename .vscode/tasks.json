{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build all Revit versions",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/build.ps1",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build + install for Revit 2026",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/build.ps1 -Versions 2026 -Deploy",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Revit 2024 only",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/build.ps1 -Versions 2024",
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
