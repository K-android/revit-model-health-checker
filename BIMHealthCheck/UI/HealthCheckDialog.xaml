<Window x:Class="BIMHealthCheck.UI.HealthCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BIM Model Health Scorecard &amp; Audit" 
        Height="780" Width="1020" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern ScrollBar -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Style -->
        <Style x:Key="FilterPillButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF3FB"/>
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Scorecard & Discipline Breakdown -->
        <Border Grid.Row="0" Background="White" Padding="20,16" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Top Row: Project Title + Trend + Overall Score -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ONE-CLICK PROJECT SCORECARD" FontSize="11" FontWeight="Bold" Foreground="#0078D7" Margin="0,0,10,0"/>
                            <Border x:Name="TrendBadgeBorder" Background="#E8F5E9" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TrendText" Text="📊 Baseline run" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ModelNameText" FontSize="20" FontWeight="Bold" Foreground="#222222" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ModelPathText" FontSize="11" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" HorizontalAlignment="Right">
                            <TextBlock Text="Overall Health" FontSize="12" Foreground="#666666" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="GradeText" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Border x:Name="ScoreBorder" Width="72" Height="72" CornerRadius="36" Background="#27AE60" 
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ScoreText" FontSize="26" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Second Row: Discipline Scorecards Grid -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Architecture Card -->
                    <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="🏛 Architecture" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
                            <TextBlock x:Name="ArchScoreText" Text="-- / 100" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Structure Card -->
                    <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="🏗 Structure" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
                            <TextBlock x:Name="StructScoreText" Text="-- / 100" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- MEP Card -->
                    <Border Grid.Column="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="⚡ MEP Systems" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
                            <TextBlock x:Name="MepScoreText" Text="-- / 100" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Coordination Card -->
                    <Border Grid.Column="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="🌐 Coordination" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
                            <TextBlock x:Name="CoordScoreText" Text="-- / 100" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Third Row: Severity Level Filter Bar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Severity Filter:" FontSize="11" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="FilterAllBtn" Style="{StaticResource FilterPillButton}" Content="All (0)" Click="OnSeverityFilterClick" Tag="All"/>
                    <Button x:Name="FilterCriticalBtn" Style="{StaticResource FilterPillButton}" Content="🔴 Critical (0)" Click="OnSeverityFilterClick" Tag="Critical"/>
                    <Button x:Name="FilterErrorBtn" Style="{StaticResource FilterPillButton}" Content="🟠 Error (0)" Click="OnSeverityFilterClick" Tag="Error"/>
                    <Button x:Name="FilterWarningBtn" Style="{StaticResource FilterPillButton}" Content="🟡 Warning (0)" Click="OnSeverityFilterClick" Tag="Warning"/>
                    <Button x:Name="FilterInfoBtn" Style="{StaticResource FilterPillButton}" Content="🔵 Info (0)" Click="OnSeverityFilterClick" Tag="Info"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content: Category Findings Cards -->
        <ScrollViewer Grid.Row="1" Margin="20,15,20,15">
            <StackPanel x:Name="ResultsPanel">
                <!-- Dynamically populated in code-behind -->
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Bar -->
        <Border Grid.Row="2" Background="White" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Export HTML Report" Click="ExportHtmlButton_Click"/>
                        <Button Content="Export CSV" Style="{StaticResource SecondaryButton}" Click="ExportCsvButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusMessageText" 
                               Text="💡 Tip: Click '🔍 Show' or double-click any row to highlight and zoom to that element in Revit." 
                               FontSize="11" Foreground="#444444" Margin="5,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" MinWidth="100" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
